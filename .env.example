# Copy to .env and fill in. .env is gitignored and must never be committed.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: SEC requires a descriptive User-Agent on api requests.
DOSSIER_SEC_USER_AGENT=dossier research contact@example.com

# Optional: graph backend. networkx (default) or neo4j.
DOSSIER_GRAPH_BACKEND=networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dossierdev

# Optional: record | replay | live  (default live)
DOSSIER_LLM_MODE=live

# Optional: OpenTelemetry OTLP endpoint. When unset, tracing stays in SQLite only.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
